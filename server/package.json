{
  "name": "fripon-cloud",
  "description": "Fripon Cloud: the subscription server behind the Fripon extension (auth, quotas, billing, Google proxy).",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build:resync": "esbuild scripts/stripe-resync.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist/stripe-resync.js",
    "stripe:resync": "npm run build:resync && node --env-file-if-exists=.env dist/stripe-resync.js",
    "build:setup": "esbuild scripts/stripe-setup.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist/stripe-setup.js",
    "stripe:setup": "npm run build:setup && node --env-file-if-exists=.env dist/stripe-setup.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
