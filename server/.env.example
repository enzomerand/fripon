# Fripon Cloud: environment of the server (read by server/src/config.ts).
#
# Copy this file to server/.env (never committed, chmod 600) and fill it in. Rules:
# - one KEY=value per line, no quotes, no comment after a value (compose reads the file as is);
# - the server refuses to start in production while a required variable is missing or invalid, and
#   lists every problem at once (`docker compose -f server/compose.yml logs fripon-cloud`).
#
# NODE_ENV=production and DATABASE_PATH=/data/fripon.db are set by the image: do not set them here.

# --- Server ---------------------------------------------------------------------------------

# Port the server listens on inside the container (Caddy proxies to it). Default 8787.
# PORT=8787

# Public https address of the server: Stripe sends the buyer back to it after Checkout. Required.
PUBLIC_URL=https://fripon.endurance.tools

# Read the client address from X-Forwarded-For. Required in production, true or false, no default:
# the server refuses to start without it. true behind the reverse proxy (Caddy fronts the app);
# false without a proxy in front, or a client could write the address it likes.
TRUST_PROXY=true

# Where the owner's alerts go (a plain e-mail, at most one per kind per hour): a refused Google
# key, a double subscription, a failing webhook, a dispute, a global ceiling reached. Required in
# production. Put it on an address you read: it is what warns you before the users do.
OWNER_EMAIL=you@example.com

# Secret that signs the sign-in codes (32 characters minimum). Required, no default on purpose:
# generate one with `openssl rand -hex 32`. A leak lets anyone forge a valid code.
AUTH_SECRET=

# Vision calls per day (Pacific time, like Google's quota), all accounts together, on top of the
# quota set in Google Cloud. Default 3000, between 1 and 1000000.
# GLOBAL_DAILY_VISION_CAP=3000

# AI reviews per day, all accounts together, whoever writes them (Claude or Gemini), on top of the
# provider's own limits. Same rules: the day is Google's (midnight Pacific time). Default 5000,
# between 1 and 1000000. Called GLOBAL_DAILY_GEMINI_CAP before Claude: that name is still read when
# this one is unset.
# GLOBAL_DAILY_REVIEW_CAP=5000

# --- Google Vision (the owner's key, restricted to its API; see docs/cloud.md) ---------------

# Cloud Vision API key (WEB_DETECTION, the image search). Required.
GOOGLE_VISION_KEY=AIza...

# --- The AI review (see docs/cloud.md) --------------------------------------------------------

# Who writes the AI review: claude (Claude Haiku 5.5, Anthropic API) or gemini (the default when
# this is unset). Only the key of the provider in use is required; the other one is ignored.
AI_PROVIDER=claude

# Anthropic API key (console.anthropic.com), required when AI_PROVIDER=claude. The API is prepaid:
# buy credits there (auto-reload keeps it from running dry).
ANTHROPIC_API_KEY=sk-ant-...

# Gemini API key, required when AI_PROVIDER=gemini. The project needs billing; a new account is
# often on prepaid credits (AI Studio > Billing).
# GEMINI_KEY=AIza...

# --- Stripe ---------------------------------------------------------------------------------

# Secret (sk_...) or restricted (rk_...) key. sk_test_... until the live switch.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret (whsec_...) of the webhook endpoint https://<PUBLIC_URL>/v1/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# Ask the buyer to accept the terms at Checkout. Set a terms-of-service URL in the Stripe Dashboard
# first, then switch this to true (`scripts/configure.sh --live` does, with the live key).
# Default false.
STRIPE_REQUIRE_TERMS=false

# Customer portal configuration (bpc_...) printed by `npm --prefix server run stripe:setup`.
# Only needed when the Dashboard has no default portal configuration.
# STRIPE_PORTAL_CONFIGURATION=bpc_...

# --- Legal pages ----------------------------------------------------------------------------

# The terms of sale (/cgv) and the privacy policy (/confidentialite) are drafts: they show a
# "Brouillon à faire relire" banner and ask search engines to skip them. Fill in the publisher's
# details in server/src/legal/entity.ts (the one place) and every other [À COMPLÉTER : ...] of
# server/src/legal/, have the texts reviewed, then switch this to true.
# Default false.
LEGAL_PAGES_FINAL=false

# --- Mail (the sign-in code) ----------------------------------------------------------------

# SMTP server. Required in production. smtp:// (port 587, STARTTLS) or smtps:// (port 465).
# URL-encode special characters of the user and password (@ -> %40, : -> %3A, / -> %2F).
SMTP_URL=smtp://user:pass@host:587

# Sender of the code. Use an address of a domain the SMTP server may send for. Required.
MAIL_FROM=Fripon <no-reply@example.com>
